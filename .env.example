# Database
POSTGRES_HOST=payments_db
POSTGRES_PORT=5432
POSTGRES_DB=payments_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# RabbitMQ
RABBIT_HOST=rabbit_mq
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASSWORD=guest
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# API
API_KEY=change-me

# Consumer
CONSUMER_MAX_ATTEMPTS=3
CONSUMER_PREFETCH_COUNT=10

# Webhook delivery & retry
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_BASE_DELAY_SECONDS=2
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_RETRY_POLL_INTERVAL_SECONDS=1.0
WEBHOOK_RETRY_ERROR_BACKOFF_SECONDS=3.0
WEBHOOK_RETRY_BATCH_SIZE=100
WEBHOOK_RETRY_CLAIM_SECONDS=300

# Outbox dispatcher
DISPATCH_POLL_INTERVAL_SECONDS=1.0
DISPATCH_ERROR_BACKOFF_SECONDS=3.0
DISPATCH_BATCH_SIZE=100
CLAIM_RELEASE_SECONDS=300
MAX_OUTBOX_ATTEMPTS=3
OUTBOX_RETRY_BASE_DELAY_SECONDS=2
